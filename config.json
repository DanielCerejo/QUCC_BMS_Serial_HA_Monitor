{
    "name": "QUCC Smart BMS Serial (USB) Monitor",
    "version": "1.0.18",
    "slug": "dcc-bms",
    "description": "Monitors a QUCC Smart BMS through UART USB",
    "arch": ["amd64", "aarch64"],
    "startup": "application",
    "boot": "auto",
    "privileged": ["SYS_RAWIO"],
    "devices": ["/dev/ttyUSB0", "/dev/ttyUSB1"],
    "init": false,
    "options": {
        "mqtt_server": "core-mosquitto",
        "mqtt_user": "mqtt",
        "mqtt_pass": "mqtt",
        "mqtt_client_id": "quccbms",
        "mqtt_discovery_prefix": "homeassistant",
        "device": "/dev/ttyUSB0",
        "device_id": "QUCC-Smart-BMS",
        "device_polling_interval": 30,
        "nominal_voltage": 76.8,
        "verify_crc": true,
        "debug_frames": false
    },
    "schema": {
        "mqtt_server": "str",
        "mqtt_user": "str",
        "mqtt_pass": "password",
        "mqtt_client_id": "str",
        "mqtt_discovery_prefix": "str",
        "device": "str",
        "device_id": "str",
        "device_polling_interval": "int(5,120)",
        "nominal_voltage": "float(12.0,100.0)",
        "verify_crc": "bool",
        "debug_frames": "bool"
    }
}
